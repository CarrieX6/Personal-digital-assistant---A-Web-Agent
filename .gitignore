# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# python
/.venv/
__pycache__/
*.py[cod]
/.pytest_cache/
*.egg-info/
/backend/data/*.jsonl
/backend/data/settings.json
/backend/data/feishu_settings.json
/backend/data/*.enc
/backend/data/.secret_master_key
/backend/data/viewer-secret.key
/backend/data/viewer-public-url.json
/backend/data/channel.sqlite3*
/backend/data/identity.sqlite3*
/backend/data/assets/
/backend/data/source-images/
/backend/data/flux-gs-datasets/
/backend/data/native-cache/
/backend/data/assets.sqlite3*
/backend/data/agent_checkpoints.sqlite3*
/backend/data/agent_memory.sqlite3*
/backend/data/capability_setup.sqlite3*
*.memory-key

# local Codex runtime permissions
/.codex/config.toml

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/backend/models/
/.capabilities/
/.idea/
