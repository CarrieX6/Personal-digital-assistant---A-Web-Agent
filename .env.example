NEXT_PUBLIC_AGENT_API_URL=http://127.0.0.1:8000

# 推荐直接在网页右上角“模型设置”中填写、测试并保存。
# 以下变量仅作为无 UI 场景的兼容配置；网页保存过配置后以网页配置为准。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# 空间照片主体分割：
# auto: macOS 14+ 优先 Apple Vision；其他平台优先 BiRefNet；失败后降级深度蒙版。
# vision/birefnet/depth: 强制指定后端，便于 Windows 和模型质量排查。
SPATIAL_FOREGROUND_SEGMENTER=auto
SPATIAL_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
SPATIAL_BIREFNET_MODEL=ZhengPeng7/BiRefNet
SPATIAL_BIREFNET_SIZE=1024
# 生产/离线部署建议先预下载权重，再设为 true，避免运行时联网。
SPATIAL_BIREFNET_LOCAL_FILES_ONLY=false

# Agent 上下文分层预算。总预算还包含系统提示和工具 Schema，子预算会自动限幅。
AGENT_CONTEXT_TOKEN_BUDGET=98304
AGENT_OUTPUT_TOKEN_RESERVE=16384
AGENT_MINIMUM_USER_TOKENS=1024
AGENT_RECENT_HISTORY_TOKENS=32768
AGENT_RECENT_HISTORY_MESSAGES=20
AGENT_SESSION_SUMMARY_TOKENS=8192
# 单次摘要最多处理的原始消息数；限制完整序列化请求，剩余消息分块继续压缩。
AGENT_SESSION_COMPACTION_MESSAGES=240
AGENT_LONG_TERM_MEMORY_TOKENS=16384
AGENT_SMALL_TOOL_REGISTRY=8
AGENT_MAX_SELECTED_TOOLS=16

# 新摘要/召回默认 auto：在同一输入上 shadow 比较旧/新结果，达到门槛前服务旧路径，
# 达标后自动切换新路径。shadow 永不切换；legacy/structured/hybrid 仅用于显式回退或验收。
AGENT_SESSION_SUMMARY_MODE=auto
AGENT_MEMORY_RETRIEVAL_MODE=auto
AGENT_CONTEXT_SHADOW_MIN_SAMPLES=20
AGENT_CONTEXT_SHADOW_MIN_PASS_RATE=0.95

# 上下文预算默认复用本地 Embedding 模型的真实 Tokenizer，只加载 tokenizer 文件。
# auto 在本地 Tokenizer 不可用时显式回退 heuristic；生产环境可设 transformers 强制失败即停。
AGENT_TOKENIZER_BACKEND=auto
AGENT_TOKENIZER_PATH=

# 长期记忆、会话消息/标题/摘要和可恢复 Run 载荷默认使用 AES-256-GCM 加密。
# 密钥优先存入系统钥匙串；
# 无钥匙串环境回退为与数据库分离、权限受限的 *.memory-key 文件。
# 无 UI/容器环境可通过进程级 Secret 注入 AGENT_MEMORY_ENCRYPTION_KEY，勿提交到仓库。
AGENT_MEMORY_ENCRYPTION_ENABLED=true
# 稳定工作区身份用于钥匙串服务名；移动项目目录时保持不变即可继续解密旧数据。
# 多个完全隔离的本地实例应分别设置不同值，并同时备份各自数据库与密钥。
AGENT_WORKSPACE_ID=personal-digital-assistant

# 隐私安全的混合召回 v2。默认关闭以保持现有部署行为；启用后推荐 transformer。
# hash 仍可显式作为零下载基线；Transformer 运行时只读取本地固定版本文件。
AGENT_MEMORY_SEMANTIC_ENABLED=false
AGENT_MEMORY_EMBEDDING_PROVIDER=transformer
AGENT_MEMORY_EMBEDDING_MODEL_PATH=backend/models/embeddings/granite-embedding-97m-multilingual-r2
AGENT_MEMORY_EMBEDDING_MANIFEST=
AGENT_MEMORY_EMBEDDING_DEVICE=auto
AGENT_MEMORY_EMBEDDING_DTYPE=auto
AGENT_MEMORY_EMBEDDING_BATCH_SIZE=16
AGENT_MEMORY_EMBEDDING_MAX_LENGTH=1024
AGENT_MEMORY_EMBEDDING_VERIFY_HASHES=true
# true 会在启动时加载并自检模型，失败则阻止服务启动；false 会安全回退词法召回。
AGENT_MEMORY_EMBEDDING_REQUIRED=false
# 留空时 Hash 默认 0.24，Transformer 默认使用经本项目回归评测的 0.80。
AGENT_MEMORY_SEMANTIC_THRESHOLD=
AGENT_MEMORY_RRF_K=60
AGENT_MEMORY_MMR_LAMBDA=0.78

# 仅局域网空间照片 Viewer 监听；Root 控制台和 Agent API 仍只监听 127.0.0.1。
LAN_VIEWER_BIND=0.0.0.0
LAN_VIEWER_PORT=8766
LAN_VIEWER_TTL_SECONDS=43200
# 后续配置 HTTPS 域名/反向代理时填写，当前局域网阶段保持为空。
LAN_VIEWER_PUBLIC_BASE_URL=
# 开发期可选：自动维护 TryCloudflare 临时公网地址。只有明确接受私人图片经公网转发时
# 才同时设为 true；正式上线改用固定域名的 Named Tunnel。
PUBLIC_VIEWER_AUTO_START=false
PUBLIC_VIEWER_ACKNOWLEDGE_PUBLIC_MEDIA=false

# 图片风格化产品默认连接独立 frogi-m/pic-style SDXL + IP-Adapter 服务。
# local-preview 只用于无 GPU 的显式开发测试，不代表真实风格迁移效果。
PHOTO_STYLE_PROVIDER=pic-style-http
PHOTO_STYLE_SERVICE_URL=http://127.0.0.1:18000
PHOTO_STYLE_SERVICE_API_KEY=
PHOTO_STYLE_TENANT_ID=personal-agent
PHOTO_STYLE_TIMEOUT_SECONDS=900

# 本机真实模型：先运行 prepare_photo_style_models.py 并显式接受各模型许可证，
# 再把 Provider 改为 sdxl-local。运行时只读取固定 revision 的本地文件，不联网下载。
PHOTO_STYLE_MODEL_ROOT=backend/models/photo-style
PHOTO_STYLE_MODEL_MANIFEST=backend/config/photo-style-models.json
PHOTO_STYLE_PROVIDER_GATE=backend/config/photo-style-provider-gate.json
PHOTO_STYLE_MODEL_LOCK=backend/models/photo-style/model-lock.json
PHOTO_STYLE_LCM_PREVIEW_ENABLED=false
PHOTO_STYLE_VERIFY_MODEL_HASHES=false
# 默认用单次隔离进程运行并回收约 10GB 权重；连续批处理可改为 false 以常驻模型。
PHOTO_STYLE_UNLOAD_AFTER_GENERATION=true
